# === PostgreSQL ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password_password_password

# === ClickHouse ===
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=user
CLICKHOUSE_PASSWORD=password_password_password
CLICKHOUSE_DB=default

# === Redis (optional) ===
REDIS_HOST=redis
REDIS_PORT=6379

# === Docker ===
# The host's docker group id, used only by the socket-proxy sidecar (it runs as
# nobody plus this group so it can reach /var/run/docker.sock without being root).
# `make install` fills it in from the host; the default suits most Debian boxes.
DOCKER_GID=991

# === Database pool (backend) ===
# Each request holds its connection until its response is finished, and the
# dashboard polls many endpoints at once. `pool_timeout` is how long a request
# waits for a free connection before it fails fast instead of hanging.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=15
DB_POOL_RECYCLE=1800

# === JWT ===
JWT_SECRET=your_jwt_secret_1234567890
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# === Ad-platform OAuth "Connect" apps (Settings → Integrations) ===
# App credentials live ONLY in the environment — never in the database or the UI.
# Fill in the pair for each platform you connect; a platform whose pair is unset
# shows "not configured by this deployment" and its Connect button is disabled.
#
# The public origin used to build the callback URL to register with each provider
# (must end with /backend/api/integrations/<platform>/callback on the provider side).
PUBLIC_BASE_URL=https://your-domain.example

# Key used to encrypt stored OAuth tokens at rest. Accepts a Fernet key
# (generate one: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# or any long passphrase (derived with SHA-256). Required to store tokens; if
# unset, Connect refuses to store a token rather than writing it in plaintext.
INTEGRATIONS_ENCRYPTION_KEY=

# Meta (Facebook) app — App ID + App Secret from developers.facebook.com.
# Meta Graph API version (Meta is date-versioned; each version lives ~2 years)
META_GRAPH_VERSION=v26.0
META_APP_ID=
META_APP_SECRET=
# Snapchat Marketing API app.
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
# TikTok for Business app.
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
# Pinterest app.
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# Google Ads OAuth client (plus the developer token issued for the Ads API).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=

# Copilot (AI summary / Q&A page). The service key, endpoint and model come from
# the deployment environment; when the key is empty the Copilot page shows a
# "not configured" state. None of these are exposed in the product UI — the
# Settings card only has the on/off switch and the token cap.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
COPILOT_MODEL=

# === Outbound notifications (email + Telegram) ===
# The relay and the bot belong to the deployment, not to a workspace: the
# product never asks a user for them. Email is usable with either an API key or
# a complete SMTP triple; the API key wins when both are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_LOGIN=
SMTP_PASSWORD=
EMAIL_API_KEY=

# The deployment's Telegram bot. Users open the deep link published on the
# Settings page and supply only their own chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Ad-platform Graph host override (Meta cost sync + campaign controls).
# Leave empty for the real Graph host; used by tests and staging.
META_GRAPH_BASE_URL=
# Conversions API (CAPI) Graph host override — same idea, for the outbound
# sender in the frontend container. Leave empty for the real Graph host.
META_CAPI_GRAPH_BASE=

